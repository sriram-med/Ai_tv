<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic">
    <alpha android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="190"/>
    <scale android:fromXScale="1.0" android:toXScale="0.96"
        android:fromYScale="1.0" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" android:duration="210"/>
    <translate android:fromYDelta="0%" android:toYDelta="1%"
        android:duration="210"/>
</set>